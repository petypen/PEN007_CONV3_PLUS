//@skip-check extension-method-prefix
#Область СлужебныеПроцедурыИФункции

// Возвращает имя события для записи в ЖР (на основании имен модуля и метода).
//
// Параметры:
//  ИмяМетода - Строка - Имя функции или процедуры
//
// Возвращаемое значение:
//  Строка
&НаСервере
Функция ИмяСобытия(ИмяМетода)
	Возврат СтрШаблон("%1.%2", ИмяМодуля(), ИмяМетода);
КонецФункции

&НаСервере
Функция ИмяМодуля()
	Возврат ОбъектМетаданных().Имя;
КонецФункции

&НаСервере
Функция ОбъектМетаданных()
	Возврат Метаданные.Справочники.Алгоритмы.Формы.ФормаЭлемента;
КонецФункции

#КонецОбласти