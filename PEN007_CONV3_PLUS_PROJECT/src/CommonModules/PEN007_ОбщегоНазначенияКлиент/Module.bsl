#Область ПрограммныйИнтерфейс

// Открывает форму правила конвертации (ПКО или ПКПД), на которое ссылается правило конвертации свойств.
// Форма открывается независимо от формы ПКС: в отдельном окне или вкладке приложения, как это настроено
// у пользователя. Закрытие формы ПКС открытую форму правила не закрывает.
// 
// Параметры:
//  ФормаПКС - см. Справочник.ПравилаКонвертацииСвойств.Форма.ФормаЭлемента
Процедура ПерейтиКПравилуКонвертацииСвойства(ФормаПКС) Экспорт

	// В вызов сервера передаются только значения в локальных переменных: реквизит формы "Объект"
	// (объект данных формы) передавать нельзя - платформа пытается записать его обратно в реквизит
	// и падает с ошибкой "Нельзя изменять поле, содержащее объект данных формы".
	ВладелецПКС = ФормаПКС.Объект.Владелец;
	ИдентификаторПравила = ФормаПКС.Объект.ПравилоКонвертацииСвойства;

	Правило = PEN007_ОбщегоНазначенияВызовСервера.ПравилоКонвертацииДляПерехода(ВладелецПКС, ИдентификаторПравила);

	Если Правило = Неопределено Тогда
		ПоказатьПредупреждение( , НСтр(
			"ru = 'Правило конвертации свойства не заполнено или не найдено в составе конвертации.'"));
		Возврат;
	КонецЕсли;

	ИмяФормыПравила = ИмяФормыПравилаКонвертации(Правило, ФормаПКС.ЭтоКонвертацияXDTO);
	ПараметрыФормы = Новый Структура("Ключ", Правило);

	ОткрытьФорму(ИмяФормыПравила, ПараметрыФормы, , , , , , РежимОткрытияОкнаФормы.Независимый);

КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

// Имя формы правила конвертации по ссылке на правило.
// У правил конвертации предопределенных данных формы элемента XDTO и XML конвертаций разные,
// поэтому тип конвертации передается параметром.
// 
// Параметры:
//  Правило - СправочникСсылка.ПравилаКонвертацииОбъектов,
//            СправочникСсылка.ПравилаКонвертацииПредопределенныхДанных - правило конвертации
//  ЭтоКонвертацияXDTO - Булево - Истина, если конвертация выполняется по формату XDTO
// 
// Возвращаемое значение:
//  Строка - полное имя формы правила конвертации
Функция ИмяФормыПравилаКонвертации(Правило, ЭтоКонвертацияXDTO)

	ТипПравила = ТипЗнч(Правило);

	Если ТипПравила = Тип("СправочникСсылка.ПравилаКонвертацииОбъектов") Тогда
		Возврат "Справочник.ПравилаКонвертацииОбъектов.Форма.ФормаЭлемента";
	КонецЕсли;

	Если ТипПравила = Тип("СправочникСсылка.ПравилаКонвертацииПредопределенныхДанных") Тогда
		Если ЭтоКонвертацияXDTO Тогда
			Возврат "Справочник.ПравилаКонвертацииПредопределенныхДанных.Форма.ФормаЭлементаXDTO";
		КонецЕсли;
		Возврат "Справочник.ПравилаКонвертацииПредопределенныхДанных.Форма.ФормаЭлементаXML";
	КонецЕсли;

	ВызватьИсключение СтрШаблон(НСтр("ru = 'Неизвестный тип правила конвертации: %1'"), ТипПравила);

КонецФункции

#КонецОбласти
