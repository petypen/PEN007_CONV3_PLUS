// @strict-types
#Область ПрограммныйИнтерфейс

#Область ПКС_ФормаЭдемента

// Справочник ПКС - Форма элемента - Модификация интерфейса.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - модифицируемая форма
Процедура ПКС_ФормаЭлемента_МодификацияИнтерфейса(Форма) Экспорт

	ДобавитьКнопкуПерейтиКПКО(Форма);

КонецПроцедуры

#КонецОбласти

#Область СправочникПКО_ФормаЭлемента

// Справочник Правила конвертации объектов - Форма элемента - Модификация интерфейса.
// Корректирует условное оформление ключевых свойств формата: в базовой форме
// используется уменьшенный полужирный шрифт, в результате чего колонка
// "Свойство формата" визуально отличается от основного оформления формы.
// Заменяет шрифт на полужирный стандартного размера формы.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - модифицируемая форма
Процедура ПКО_ФормаЭлемента_МодификацияИнтерфейса(Форма) Экспорт

	ИсправитьОформлениеКлючевыхСвойствФормата(Форма);

КонецПроцедуры

// Заменяет в условном оформлении формы шрифт для элемента оформления колонки
// "Свойство формата" таблицы "Правила конвертации свойств" на полужирный шрифт
// стандартного размера (DefaultGUIFont).
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - модифицируемая форма
Процедура ИсправитьОформлениеКлючевыхСвойствФормата(Форма)

	ИмяПоляСвойстваФормата = "ПравилаКонвертацииСвойствСвойствоФормата";
	НужныйШрифт = Новый Шрифт(ВидШрифта.АвтоШрифт, , Истина);

	Для Каждого ЭлементОформления Из Форма.УсловноеОформление.Элементы Цикл
		Если ЭлементОформления.Поля.Элементы.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если ЭлементОформления.Поля.Элементы[0].Поле <> Новый ПолеКомпоновкиДанных(ИмяПоляСвойстваФормата) Тогда
			Продолжить;
		КонецЕсли;
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Шрифт", НужныйШрифт);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Код процедур и функций

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьКнопкуПерейтиКПКО(Форма)

	Заголовок = "Перейти к правилу конвертации объекта";
	ИмяКоманды = "КомандаОткрытьФормуПКО";
	ПФИВызовСервера.СоздатьКоманду(Форма, ИмяКоманды, Заголовок, "PEN007_ОткрытьФормуПКО");
	
	// Кнопка PEN007_КнопкаОткрытьФормуПКО
	Родитель = Форма.Элементы.Найти("ГруппаНастройкаПравилаКонвертацииСвойства");
	Если Родитель <> Неопределено Тогда
		ЭлементПеред = Форма.Элементы.Найти("УказыватьПравилоКонвертацииСвойстваСтрокой");
		СвойстваЭлемента = Новый Структура();
		СвойстваЭлемента.Вставить("Картинка", БиблиотекаКартинок.ПереместитьВправо);
		СвойстваЭлемента.Вставить("Отображение", ОтображениеКнопки.Картинка);
		ПФИВызовСервера.Кнопка(Форма, "PEN007_КнопкаОткрытьФормуПКО", Родитель, Заголовок, "КомандаОткрытьФормуПКО", 1,
			СвойстваЭлемента, ЭлементПеред);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти