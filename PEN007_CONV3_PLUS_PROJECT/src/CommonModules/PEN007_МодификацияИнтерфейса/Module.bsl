// @strict-types


//
#Область ПрограммныйИнтерфейс

#Область СправочникПКС_ФормаЭлемента

// Справочник ПКС - Форма элемента - Модификация интерфейса.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - модифицируемая форма
Процедура ПКС_ФормаЭлемента_МодификацияИнтерфейса(Форма) Экспорт

	ДобавитьКнопкуПерейтиКПравилу(Форма);

КонецПроцедуры

#КонецОбласти

#Область СправочникПКО_ФормаЭлемента

// Справочник Правила конвертации объектов - Форма элемента - Модификация интерфейса.
// Корректирует условное оформление ключевых свойств формата: в базовой форме
// используется уменьшенный полужирный шрифт, в результате чего колонка
// "Свойство формата" визуально отличается от основного оформления формы.
// Заменяет шрифт на полужирный стандартного размера формы.
// Оформляет строки отключенных правил конвертации свойств (ПКС с установленным
// признаком "Отключить"): перечеркивание. Оформление задается в
// условном оформлении самого динамического списка "ПравилаКонвертацииСвойств" -
// именно оно применяется к строкам списка.
//
// Параметры:
//  Форма - см. Справочник.ПравилаКонвертацииОбъектов.Форма.ФормаЭлемента
Процедура ПКО_ФормаЭлемента_МодификацияИнтерфейса(Форма) Экспорт

	Элемент = Форма.УсловноеОформление.Элементы.Добавить();
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтыСтиля.ВажнаяНадписьШрифт);
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));

	Если Форма.ЭтоКонвертацияXDTO Тогда
		ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПравилаКонвертацииСвойств.ЭтоКлючевоеСвойство");
		ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ОтборЭлемента.ПравоеЗначение = Истина;
		// Оформляемые поля: свойство формата 
		ОформляемоеПоле = Элемент.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ПравилаКонвертацииСвойствСвойствоФормата");
	Иначе
		ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПравилаКонвертацииСвойств.Поиск");
		ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ОтборЭлемента.ПравоеЗначение = Истина;
		// Оформляемые поля: вся строка.
		ОформляемоеПоле = Элемент.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ПравилаКонвертацииСвойств");
	КонецЕсли;

	// Оформление строк отключенных правил конвертации свойств: серый фон и перечеркивание.
	// Оформляемые поля не задаются - оформляется вся строка.
	Элемент = Форма.ПравилаКонвертацииСвойств.УсловноеОформление.Элементы.Добавить();
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтыСтиля.PEN007_ОтключенноеПравилоШрифт);
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Отключить");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;

КонецПроцедуры

#КонецОбласти

#Область СправочникПОД_ФормаЭлемента

// Справочник Правила обработки данных - Форма элемента - Модификация интерфейса.
// Ставит кнопку перехода к правилу конвертации объектов (ПКО) в одну горизонтальную группу
// с флагом "Количество правил конвертации": в режиме "несколько правил" флаг стоит над списком
// ПКО, и кнопка открывает ПКО, выделенное в этом списке.
//
// Параметры:
//  Форма - см. Справочник.ПравилаОбработкиДанных.Форма.ФормаЭлемента
Процедура ПОД_ФормаЭлемента_МодификацияИнтерфейса(Форма) Экспорт

	ДобавитьКнопкуПерейтиКПравилуКонвертацииОбъекта(Форма);

КонецПроцедуры

#КонецОбласти

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

#Область СправочникПКС_ФормаЭлемента

// Добавляет на форму ПКС кнопку перехода к правилу конвертации, на которое ссылается правило конвертации
// свойств: к правилу конвертации объектов (ПКО) или к правилу конвертации предопределенных данных (ПКПД).
// Кнопка добавляется только в конвертациях типа XDTO: у XML-конвертаций правил конвертации
// предопределенных данных нет.
// Кнопка ставится в страницу "СтраницаПКСВыбор" рядом с полем "Правило конвертации св-ва":
// страница переводится в горизонтальную группировку, поле правила растягивается, кнопка
// добавляется после него.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - модифицируемая форма ПКС
Процедура ДобавитьКнопкуПерейтиКПравилу(Форма)

	// Кнопка нужна только в конвертациях XDTO, см. ЭтоКонвертацияXDTOПоПравилу.
	Если Не PEN007_ОбщегоНазначенияВызовСервера.ЭтоКонвертацияXDTOПоПравилу(Форма.Объект.Владелец) Тогда
		Возврат;
	КонецЕсли;

	Заголовок = НСтр("ru = 'Перейти к правилу конвертации'");
	ИмяКоманды = "PEN007_КомандаПерейтиКПравилуКонвертации";
	Подсказка = НСтр("ru = 'Перейти к правилу конвертации, указанному в поле ""Правило конвертации св-ва""'");
	ПФИВызовСервера.СоздатьКоманду(Форма, ИмяКоманды, Заголовок, "PEN007_ПерейтиКПравилуКонвертации", Подсказка);

	Страница = Форма.Элементы.Найти("СтраницаПКСВыбор");
	Если Страница = Неопределено Тогда
		Комментарий = "На форме ПКС не найдена страница ""СтраницаПКСВыбор""
					  |Кнопка перехода к правилу конвертации не добавлена.";
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(ИмяСобытия("ДобавитьКнопкуПерейтиКПравилу"),
			УровеньЖурналаРегистрации.Ошибка, ОбъектМетаданных(), , Комментарий);
		Возврат;
	КонецЕсли;

	// Поле правила и кнопка должны стоять в одной строке.
	Страница.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;

	// В горизонтальной группе поле правила иначе сжимается до содержимого, а кнопка уезжает влево:
	// растягиваем поле на свободное место, кнопка встает сразу за ним.
	ПолеПравила = Форма.Элементы.Найти("ПравилоКонвертацииСвойства");
	Если ПолеПравила <> Неопределено Тогда
		ПолеПравила.АвтоМаксимальнаяШирина = Ложь;
		ПолеПравила.РастягиватьПоГоризонтали = Истина;
	КонецЕсли;

	// Кнопка отображается только картинкой: заголовок команды виден в подсказке.
	СвойстваЭлемента = Новый Структура();
	СвойстваЭлемента.Вставить("Картинка", БиблиотекаКартинок.ПереместитьВправо);
	СвойстваЭлемента.Вставить("Отображение", ОтображениеКнопки.Картинка);

	ПФИВызовСервера.Кнопка(Форма, "PEN007_КнопкаПерейтиКПравилуКонвертации", Страница, Заголовок, ИмяКоманды, 1,
		СвойстваЭлемента);

КонецПроцедуры

#КонецОбласти

#Область СправочникПОД_ФормаЭлемента

// Добавляет на форму ПОД кнопку перехода к правилу конвертации объектов (ПКО).
// Кнопка ставится в новую обычную группу, в которую переносится флаг "Количество правил
// конвертации", - флаг и кнопка оказываются в одной строке над списком ПКО.
// Перенос существующего элемента формы выполняется программно: свойство "Родитель" доступно
// только для чтения, элемент переносит метод коллекции "Переместить" (доступен на сервере).
//
// Параметры:
//  Форма - см. Справочник.ПравилаОбработкиДанных.Форма.ФормаЭлемента
Процедура ДобавитьКнопкуПерейтиКПравилуКонвертацииОбъекта(Форма)

	ПолеКоличестваПравил = Форма.Элементы.Найти("ИспользоватьНесколькоПравилКонвертации");
	Если ПолеКоличестваПравил = Неопределено Тогда
		Комментарий = "На форме ПОД не найдено поле ""ИспользоватьНесколькоПравилКонвертации"".
					  |Кнопка перехода к правилу конвертации объектов не добавлена.";
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(ИмяСобытия("ДобавитьКнопкуПерейтиКПравилуКонвертацииОбъекта"),
			УровеньЖурналаРегистрации.Ошибка, ОбъектМетаданных(), , Комментарий);
		Возврат;
	КонецЕсли;

	// Группа вставляется перед полем и занимает его место, поле затем переносится в группу.
	// Группировка 2 - горизонтальная всегда: флаг и кнопка должны стоять в одной строке.
	// Отображение "Нет" - как у соседних групп формы, без рамки и заголовка.
	СвойстваГруппы = Новый Структура("Отображение, ОтображатьЗаголовок", ОтображениеОбычнойГруппы.Нет, Ложь);
	Группа = ПФИВызовСервера.ГруппаОбычная(Форма, "PEN007_ГруппаПравилоКонвертацииОбъекта",
		ПолеКоличестваПравил.Родитель, "", 2, 0, 0, СвойстваГруппы, ПолеКоличестваПравил);

	// Элемент не пересоздается: меняется только родитель, обработчики событий поля сохраняются.
	Форма.Элементы.Переместить(ПолеКоличестваПравил, Группа);

	Заголовок = НСтр("ru = 'Перейти к ПКО'");
	ИмяКоманды = "PEN007_КомандаПерейтиКПравилуКонвертацииОбъекта";
	Подсказка = НСтр("ru = 'Перейти к правилу конвертации объектов, указанному в правиле обработки данных'");
	ПФИВызовСервера.СоздатьКоманду(Форма, ИмяКоманды, Заголовок, "PEN007_ПерейтиКПравилуКонвертацииОбъекта", Подсказка);

	// Текст с картинкой и обычная важность - как у остальных кнопок расширения на формах правил.
	СвойстваКнопки = Новый Структура();
	СвойстваКнопки.Вставить("Картинка", БиблиотекаКартинок.ПереместитьВправо);
	СвойстваКнопки.Вставить("Отображение", ОтображениеКнопки.КартинкаИТекст);
	СвойстваКнопки.Вставить("Важность", ВажностьКнопки.Обычная);

	ПФИВызовСервера.Кнопка(Форма, "PEN007_КнопкаПерейтиКПравилуКонвертацииОбъекта", Группа,
		Заголовок, ИмяКоманды, 1, СвойстваКнопки);

КонецПроцедуры

#КонецОбласти

// Возвращает имя события для записи в ЖР (на основании имен модуля и метода).
//
// Параметры:
//  ИмяМетода - Строка - Имя функции или процедуры
//
// Возвращаемое значение:
//  Строка
Функция ИмяСобытия(ИмяМетода)
	Возврат СтрШаблон("%1.%2", ИмяМодуля(), ИмяМетода);
КонецФункции

Функция ИмяМодуля()
	Возврат ОбъектМетаданных().Имя;
КонецФункции

Функция ОбъектМетаданных()
	Возврат Метаданные.ОбщиеМодули.PEN007_МодификацияИнтерфейса;
КонецФункции

#КонецОбласти
