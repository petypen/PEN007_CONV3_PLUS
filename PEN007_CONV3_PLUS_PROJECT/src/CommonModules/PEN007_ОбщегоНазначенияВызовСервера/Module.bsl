#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Правило конвертации с указанным кодом в составе переданных конвертаций.
// В запросе правила конвертации объектов идут раньше правил конвертации предопределенных
// данных (поле "Приоритет"), поэтому при совпадении кодов берется первое правило - ПКО.
// 
// Параметры:
//  МассивКонвертаций - Массив из СправочникСсылка.Конвертации - конвертации, в составе которых ищем правило
//  Идентификатор - Строка - код правила конвертации
// 
// Возвращаемое значение:
//  СправочникСсылка.ПравилаКонвертацииОбъектов,
//  СправочникСсылка.ПравилаКонвертацииПредопределенныхДанных - найденное правило конвертации
//  Неопределено - правила с таким кодом в составе конвертаций нет
Функция ПравилоКонвертацииПоКоду(МассивКонвертаций, Идентификатор)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
				   |	Составы.ЭлементКонвертации КАК Правило,
				   |	1 КАК Приоритет
				   |ИЗ
				   |	Справочник.СоставыКонвертаций КАК Составы
				   |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПравилаКонвертацииОбъектов КАК ПКО
				   |			ПО Составы.ЭлементКонвертации = ПКО.Ссылка
				   |ГДЕ
				   |	Составы.Владелец В (&Конвертации)
				   |	И ПКО.Код = &Идентификатор
				   |
				   |ОБЪЕДИНИТЬ ВСЕ
				   |
				   |ВЫБРАТЬ
				   |	Составы.ЭлементКонвертации,
				   |	2
				   |ИЗ
				   |	Справочник.СоставыКонвертаций КАК Составы
				   |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПравилаКонвертацииПредопределенныхДанных КАК ПКПД
				   |			ПО Составы.ЭлементКонвертации = ПКПД.Ссылка
				   |ГДЕ
				   |	Составы.Владелец В (&Конвертации)
				   |	И ПКПД.Код = &Идентификатор
				   |
				   |УПОРЯДОЧИТЬ ПО
				   |	Приоритет";

	Запрос.УстановитьПараметр("Конвертации", МассивКонвертаций);
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);

	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Правило;

КонецФункции

#КонецОбласти
